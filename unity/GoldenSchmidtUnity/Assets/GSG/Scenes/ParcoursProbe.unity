  m_Script: {fileID: 11500000, guid: 6302d38a8eec6b08d8bd16c3b1f2d84e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: GSG.Runtime::GSG.Parcours.ParcoursGame
  state: 0
  checkpoints:
  - {fileID: 1881487058}
  - {fileID: 918826287}
  - {fileID: 28981353}
  - {fileID: 1075248372}
  - {fileID: 190644487}
  - {fileID: 1717415297}
  - {fileID: 2092058314}
  - {fileID: 385246832}
  - {fileID: 841329146}
  - {fileID: 11700117}
  - {fileID: 397621532}
  - {fileID: 380448209}
  - {fileID: 199875508}
  - {fileID: 1068864431}
  - {fileID: 302988519}
  stations:
  - name: "Stufen & L\xFCcke"
    hint: "Stick: laufen. Springen \xFCber die L\xFCcke \u2013 Hechten in der Luft verl\xE4ngert den Sprung."
  - name: "T\xFCrenwand"
    hint: "Zwei der f\xFCnf T\xFCren brechen auf. Lauf hinein \u2013 die anderen bleiben fest."
  - name: Schieber
    hint: "Die roten Schieber sto\xDFen dich weg. Lauf durch die L\xFCcke hinter ihnen."
  - name: Drehbalken
    hint: "\xDCber Rosa springen, unter Gelb ducken. Am Kreuz beides nacheinander."
  - name: Fahrinseln
    hint: "Spring auf die fahrenden Inseln \u2013 sie tragen dich mit."
  - name: Wippen
    hint: Die Wippen kippen unter deinem Gewicht. Bleib nah an der Mitte.
  - name: Band & Walzen
    hint: "Das Band l\xE4uft r\xFCckw\xE4rts. Spring \xFCber die rollenden Walzen."
  - name: Kletterkante
    hint: 'Zu hoch zum Springen: an die Kante springen, Festhalten halten, Stick nach vorn zieht dich hoch.'
  - name: Geisterpfad
    hint: "Nur ein Weg aus Platten tr\xE4gt. Gr\xFCn hei\xDFt sicher, die anderen brechen weg."
  - name: Fallklappen
    hint: "Klappen gl\xFChen orange, kurz bevor sie aufgehen. Auf die geschlossenen h\xFCpfen."
  - name: Windsteg
    hint: "B\xF6en dr\xFCcken dich zur Seite. Lenk dagegen und halte die Mitte."
  - name: Wechselgriffe
    hint: "Bl\xF6cke verschwinden zeitweise. Klettere Stufe f\xFCr Stufe \xFCber die, die bleiben."
  - name: Glibbergrube
    hint: "Der Glibber steigt und f\xE4llt. Spring \xFCber die Steine, wenn sie frei sind."
  - name: "T\xFCrg\xE4nge"
    hint: "Hinter jeder T\xFCr ein Gang: einer f\xFChrt weiter, einer endet blind, einer hat eine Fallt\xFCr."
  - name: Zielgerade
    hint: Die Stufen hoch und durch den Zielbogen!
  goo:
  - {fileID: 1967365180}
  start: {fileID: 1572942418}
